<http://wendang-project.github.io/data/item/1736> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q4970> ;
    ns2:P1476 "Image of Dots and Calligraphic Brushstrokes No. 1: Insect-Eroded Wood ( 点画意象系列之一: 虫蚀木)"@en,
        "点画意象系列之一：虫蚀木 "@zh,
        "Diǎnhuà yìxiàng xìliè zhī yī: Chóng shí mù"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/1285> ;
