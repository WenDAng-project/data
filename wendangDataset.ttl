    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/2492.jpg> ;
    ns1:attributedTitle "CWU 1 WRITE Logo (写)" ;
    ns1:description "This CWU is part of the WRITE logo. It consists of the red character realized by the Chinese calligraphy master Luo Qi and representing the character 写, which translates as “write.” Luo Qi reinterpreted an archaic form of 写, blending his distinctive style with elements of running script. Notably, the upper portion of the character resembles the Latin letter “W”, which inspired the integration of the letters R‑I‑T‑E to complete the word WRITE, creating a seamless visual synthesis of Chinese calligraphy and Latin script." ;
    ns1:directionality "Unidentifiable" ;
