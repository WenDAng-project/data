    ns1:attributedTitle "CWU 2 The Genetics of Reading Image (《兰亭序》)" ;
    ns1:description "This CWU consists the transcription of \"Orchid Pavilion Preface\" (Lanting ji xu 兰亭集序) written by Wang Xizhi in non-simplified characters. The text is interactive and it appears sentence by sentence under the set of signs \"translating\" the text into images (see CWU 1)." ;
    ns1:directionality "Modern" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q47071> ;
    ns1:hasCalligraphicLine true ;
    ns1:hasCharacterForm <https://www.wikidata.org/wiki/Q178528> ;
