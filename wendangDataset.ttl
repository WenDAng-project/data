<http://wendang-project.github.io/data/item/1199> a ns3:Q17514 ;
    ns2:P1476 "My way of playing basketball is born in the street (我的篮球由街头打造)"@en,
        "我的篮球由街头打造"@zh,
        "Wǒ de lánqiú yóu jiētóu dǎzào"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/1191>,
        <http://wendang-project.github.io/data/item/1193> ;
