<http://wendang-project.github.io/data/item/2067> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q597> ;
    ns2:P1476 "Writing Music - Silent Melodies:  \"Turandot\"( (写乐·无声之歌·图兰朵)"@en,
        "写乐·无声之歌·图兰朵"@zh,
        "Xiě yuè · wú shēng zhī gē · Túlánduǒ"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/84> ;
