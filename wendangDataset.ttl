<http://wendang-project.github.io/data/item/1330> a ns3:Q7725634 ;
    ns2:P1476 "Thousand Character Classic (千字文)"@en,
        "千字文"@zh,
        "Qiānzìwén"@zh-Latn ;
    ns2:P1480 <https://www.wikidata.org/entity/Q5727902> ;
    ns2:P50 <https://www.wikidata.org/entity/Q10920980> ;
    ns2:P571 "0600"^^xsd:gYear ;
    ns1:description "The \"Thousand Character Classic\" (千字文) is a Chinese poem composed during the Liang Dynasty by the scholar Zhou Xingsi. It consists of 1,000 unique characters, each used only once. Originally created as a tool for learning Chinese characters, it was adopted as content for an unlimited number of calligraphic works by famous calligraphers over the centuries. The content covers a wide range of topics, including natural phenomena, historical events, moral principles, and everyday knowledge." ;
    ns1:hasWikidataResource <https://www.wikidata.org/entity/Q1265243> .

