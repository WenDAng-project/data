<http://wendang-project.github.io/data/item/279> a ns3:Q184485 ;
    ns2:P1132 2 ;
    ns2:P1476 "Zhang Qiang's Traceology Report A/X7 (Zhang Kaini) Model [张强踪迹学报告 A/X7 (张凯妮) 模型]"@en,
        "张强踪迹学报告 A/X7 (张凯妮) 模型"@zh,
        "Zhāng Qiáng zōngjī xué bàogào A/X7 (Zhāng Kǎinī) móxíng"@zh-Latn ;
    ns2:P175 <http://wendang-project.github.io/data/item/100>,
        <http://wendang-project.github.io/data/item/306> ;
    ns2:P179 <http://wendang-project.github.io/data/item/385> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1048366>,
