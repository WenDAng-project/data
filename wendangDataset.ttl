<http://wendang-project.github.io/data/item/1000> a ns3:Q464980 ;
    ns2:P10661 <http://wendang-project.github.io/data/item/748> ;
    ns2:P1476 "Between Bamboo (竹·间) "@en,
        "竹·间"@zh,
        "Zhú·jiān"@zh-Latn ;
    ns2:P276 <https://www.wikidata.org/entity/Q42622> ;
    ns2:P580 "2019-07"^^xsd:gYearMonth ;
    ns2:P582 "2019-07"^^xsd:gYearMonth ;
    ns1:description "Wang Dongling's solo exhibition \"Between Bamboo\" (Zhu · Jian 竹·间) was held in Suzhou at Wuxiang Cultural Space (Wuxiang Wenhua Kongjian 五象文化空间), located on the third floor of Hyatt Regency (Gusu Kaiyue Jiudian 姑苏展于苏州凯悦酒店) in July 2019. In this exhibition, Wang Dongling displayed for the third time the installation “The Bamboo Path” (Zhu jing 竹径) composed of 201 bamboo poles and 30 transparent propylene sheets. This installation was first exhibited in 2017 at the OCAT Shenzhen.  "@en ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/910> .

<http://wendang-project.github.io/data/item/1002> a ns3:Q215627 ;
