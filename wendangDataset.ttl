    ns2:P2048 "150 - 330 cm (each)" ;
    ns2:P2049 "150 - 330 cm (each)" ;
    ns2:P462 <https://www.wikidata.org/entity/Q42519>,
        <https://www.wikidata.org/entity/Q71392381> ;
    ns2:P571 "2015"^^xsd:gYear ;
