<http://wendang-project.github.io/data/item/1667> a ns3:Q17514 ;
    ns2:P1476 "The tags \"Real\" and \"Restored to Ashes\" (意实-恢烬)"@en,
        "意实 - 恢烬"@zh,
        "意實 - 恢燼"@zh,
        "Yì shí - huī jìn"@zh-Latn ;
