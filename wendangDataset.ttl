<http://wendang-project.github.io/data/item/1589> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q506451> ;
    ns2:P1476 "Music and Calligraphy (音乐与书写) - Artwork"@en,
        "音乐与书写"@zh,
        "Yīnyuè yǔ shūxiě "@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/741> ;
    ns2:P180 <https://www.wikidata.org/entity/Q638>,
        <https://www.wikidata.org/entity/Q7860> ;
    ns2:P186 <https://www.wikidata.org/entity/Q11472>,
        <https://www.wikidata.org/entity/Q127418> ;
    ns2:P462 <https://www.wikidata.org/entity/Q23444>,
