<http://wendang-project.github.io/data/item/311> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q956> ;
    ns2:P1476 "The Thirty-Six Stratagems of using ink (墨法三十六计)"@en,
        "墨法三十六计"@zh,
        "Mò fǎ sānshíliù jì"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/277> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1072>,
