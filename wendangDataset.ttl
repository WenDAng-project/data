    ns2:P21 <https://www.wikidata.org/entity/Q6581097> ;
    ns2:P2561 "Qin Feng 秦风" ;
    ns2:P27 <https://www.wikidata.org/entity/Q148> ;
    ns2:P569 "1961"^^xsd:gYear ;
    ns2:P800 <http://wendang-project.github.io/data/item/2005>,
        <http://wendang-project.github.io/data/item/2006>,
