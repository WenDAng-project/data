<http://wendang-project.github.io/data/item/965> a ns3:Q7725310 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q4970> ;
    ns2:P1476 "Corporeal Calligraphy Series (书体)"@en,
        "书体"@zh,
        "Shū tǐ"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/748> ;
    ns2:P580 "2012"^^xsd:gYear ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/965.jpg> ;
    ns1:description """The Corporeal Calligraphy series (Shuti 书体) is composed of eight calligraphies on magazine sheets of paper measuring 25 x 20 cm. The sheets feature photographs of female models, over which Wang Dongling composes calligraphy in cursive writing, in his personal \r
style. These artworks, presented for the first time during the exhibition "Decanter Ink, Hangzhou Cross Year 2011-2012, Wang Dongling Solo Exhibition",  represent a clear example of the modernists' approach to calligraphic material."""@en ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/965_HR.jpg> ;
    ns1:includesArtwork <http://wendang-project.github.io/data/item/960> .

