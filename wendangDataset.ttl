    ns2:P2048 "3,5 m" ;
    ns2:P2049 "6 m" ;
    ns2:P2610 "4 m" ;
    ns2:P462 <https://www.wikidata.org/entity/Q23444>,
        <https://www.wikidata.org/entity/Q23445>,
        <https://www.wikidata.org/entity/Q3142> ;
    ns2:P571 "1986"^^xsd:gYear ;
    ns1:description "\"Big-Character Posters\" was created by Wu Shanzhuan in 1986 as part of his \"Red Humor Series\". It is a physical environment, measuring  approximately 3.5 × 4 × 6 meters, created by assembling dazibao (big-character posters),  slogans, and revolutionary symbols, but the artist rearranges them in a way that removes their original meaning. t combines commercial paintings on xuan paper of Maoist propaganda with traditional Chinese literature and philosophy. Instead of making political statements, Wu Shanzhuan plays with language to create a confusing, humorous, and strange experience. Through this playful fragmentation, the artist creates a world where meaning breaks down and is replaced by irony, laughter, and confusion: a celebration of the collapse of rigid ideological structures (Bryson 2005). " ;
    ns1:hasArtworkType <https://www.wikidata.org/entity/Q1902763>,
        <https://www.wikidata.org/entity/Q20437094> ;
    ns1:hasColophon false ;
    ns1:hasSeal false ;
    ns1:hasUnit <http://wendang-project.github.io/data/item/2213> ;
    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> ;
    ns1:vectorisedOrDigitised true .

<http://wendang-project.github.io/data/item/224> a ns3:Q4502142 ;
