    ns2:P580 "2021-12-06"^^xsd:date ;
    ns2:P582 "2021-12-20"^^xsd:date ;
    ns1:description "This exhibition was held from December 6 to 20, 2021 at the Song Yang Art Museum (Song Yang meishu guan 宋洋美术馆) of Beijing. Through graphic photography, installations, and videos, Wu Xixia's work addresses the awakening of women under scrutiny, using vibrant colors to convey the empowerment and flourishing spirit of women. In particular, the artist Wu Xixia showed her installation called \"Her Mountain\" (Ta shan 她山). "@en ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/536> .

<http://wendang-project.github.io/data/item/1939> a ns3:Q215627 ;
