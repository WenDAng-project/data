    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1936_1.jpg>,
        <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1936_2.jpg>,
