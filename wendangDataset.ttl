<http://wendang-project.github.io/data/item/1213> a ns3:Q17514 ;
    ns2:P1476 "Red Bull Dragon"@en ;
    ns2:P170 <http://wendang-project.github.io/data/item/1215>,
        <http://wendang-project.github.io/data/item/1216> ;
