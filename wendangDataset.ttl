    ns2:P2561 "Tong Yang-Tze 董陽孜 " ;
    ns2:P27 <https://www.wikidata.org/entity/Q865> ;
    ns2:P569 "1942"^^xsd:gYear ;
    ns2:P800 <http://wendang-project.github.io/data/item/1845>,
