<http://wendang-project.github.io/data/item/2498> a ns1:CalliWritingUnit ;
    ns2:P180 <https://www.wikidata.org/entity/Q1094542>,
        <https://www.wikidata.org/entity/Q1666147> ;
    ns2:P282 <https://www.wikidata.org/entity/Q41670> ;
    ns2:P407 <https://www.wikidata.org/entity/Q1860> ;
    ns2:P462 <https://www.wikidata.org/entity/Q23445> ;
    ns2:P9302 <http://w3id.org/write/thesaurus/square_word_calligraphy> ;
    ns1:attributedTitle "CWU CAFA ART INFO Logo (CAFA ART INFO)" ;
    ns1:description "This CWUconsists of the three words CAFA ART INFO written using the unique writing system developed by Xu Bing, known as “New English Calligraphy” (Xin Yingwen shufa 新英文书法) or “Square Word Calligraphy” (Yingwen fangkuaizi shufa 英文方块字书法).  Each word is contained within an imaginary square, mirroring the spatial arrangement of traditional Chinese characters. The letters of each word are constructed as if they were strokes of a characters, adhering to a specific sequence and methodology devised by Xu Bing. The resulting forms retain the dynamic qualities of ink brushwork, which are then vectorized and stylized to create the digital script. This approach produces a hybrid visual language, merging the structural logic of Chinese calligraphy with the legibility of Latin script." ;
    ns1:directionality "Free" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23444> ;
    ns1:hasCalligraphicLine true ;
    ns1:hasColophon false ;
    ns1:hasSignificance "Meaningful writing" ;
    ns1:isUnitOf <http://wendang-project.github.io/data/item/2496> ;
    ns1:transcriptionAndTranslation "CAFA ART INFO "@en ;
    ns1:vectorisedOrDigitised true .

<http://wendang-project.github.io/data/item/2515> a ns3:Q1400264 ;
    ns2:P2561 "Marc & Chantal Design" ;
    ns2:P276 <https://www.wikidata.org/entity/Q8646> ;
    ns2:P571 "1993"^^xsd:gYear ;
    ns2:P856 <https://www.marc-chantal.com/> ;
    ns1:description """Marc & Chantal is a cross-disciplinary branding and design agency founded in 1993 in Hong Kong by creatives Marc Cansier, Chantal Réchaussat, and Marc Brulhart, with offices in Beijing and Europe (Barcelona). Their practice spans from brand strategy and visual identity to the design of environments, sensory experiences, and immersive projects, integrating graphic design, interior design, wayfinding, and visual storytelling within a holistic design approach.\r
The trio operates as a form of artistic and creative collective, combining international backgrounds with a strong sensitivity to local cultures in order to develop projects for high-profile clients, including work in the hospitality, cultural, and retail sectors.\r
An example of their work is the Hermès object and tableware collection “Les Poèmes du Mandarin” for which Marc & Chantal oversaw the creative direction and integrated design in close collaboration with the brand.""" ;
    ns1:hasArtisticCollectiveType <https://www.wikidata.org/wiki/Q1443933> ;
    ns1:isDesignerOf <http://wendang-project.github.io/data/item/730> .

<http://wendang-project.github.io/data/item/2519> a ns1:CalliWritingUnit ;
