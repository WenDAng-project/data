<http://wendang-project.github.io/data/item/1641> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q60> ;
    ns2:P1476 "Cursive Wild/Grass - Artwork"@en ;
    ns2:P170 <http://wendang-project.github.io/data/item/1642> ;
    ns2:P180 <https://www.wikidata.org/entity/Q607543>,
