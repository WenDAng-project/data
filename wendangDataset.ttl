<http://wendang-project.github.io/data/item/117> a ns3:Q17514 ;
    ns2:P1476 "New Style (竹）"@en,
        "竹"@zh,
        "Zhú"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/112>,
