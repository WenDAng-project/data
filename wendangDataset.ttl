    ns1:hasProductType <https://www.wikidata.org/entity/Q200814> ;
    ns1:hasSeal true ;
    ns1:hasUnit <http://wendang-project.github.io/data/item/2539> .

<http://wendang-project.github.io/data/item/2320> a ns3:Q17514 ;
    ns2:P1476 "I am sick (我有病)"@en,
        "我有病"@zh,
        "Wǒ yǒu bìng"@zh-Latn ;
    ns2:P179 <http://wendang-project.github.io/data/item/2319> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1274479>,
        <https://www.wikidata.org/entity/Q1499013>,
        <https://www.wikidata.org/entity/Q5183597> ;
    ns2:P186 <https://www.wikidata.org/entity/Q3055935>,
        <https://www.wikidata.org/entity/Q42948> ;
    ns2:P462 <https://www.wikidata.org/entity/Q1088>,
        <https://www.wikidata.org/entity/Q23445> ;
    ns2:P571 "2021"^^xsd:gYear ;
    ns2:P941 <https://www.wikidata.org/entity/Q81068910> ;
    ns1:description """The graffito ‘I am sick (wo you bing 我有病)’ seemed to convey much more than a simple outburst; rather, it reflected a deeper sense of distress. What makes this graffito particularly striking is that, while it appears at first glance to be an extensive phrase, it consists of only three characters, wo you bing 我有病 (I am sick), repeated over and over until it covers the entire wall. \r
This choice of repetition may have been deliberate, aiming to evoke a sense of obsession or anguish, feelings often associated with illness. The repetitive nature of the message emphasizes the pervasive and consuming nature of mental suffering, hinting at a struggle that extends beyond physical health. \r
At the end of the repeated phrase ‘Wo you bing 我有病’ (I am sick), the words ‘wo ai ni 我爱你’  (I love you) appear in blue in the bottom right corner, differing from the earlier black inscriptions. This was likely added later by another emotional graffiti writer, perhaps as a gesture of consolation toward the original author."""@en ;
    ns1:hasChengyu false ;
    ns1:hasColophon false ;
    ns1:hasGraffitiGenre <http://w3id.org/write/thesaurus/public_free_art>,
        <http://w3id.org/write/thesaurus/public_social_political_art> ;
    ns1:hasGraffitiStyle <http://w3id.org/write/thesaurus/anti_style> ;
