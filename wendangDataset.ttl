    ns1:hasCharacterForm <https://www.wikidata.org/wiki/Q178528> ;
    ns1:hasColophon true ;
    ns1:hasSignificance "Meaningful writing" ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/2090.png> ;
    ns1:isUnitOf <http://wendang-project.github.io/data/item/1915> ;
    ns1:madeUsingTool <https://www.wikidata.org/entity/Q474188> ;
