    ns2:P276 <https://www.wikidata.org/entity/Q4970> ;
    ns2:P585 "2010-04-13"^^xsd:date ;
    ns2:P608 <http://wendang-project.github.io/data/item/1999> ;
    ns2:P941 <http://wendang-project.github.io/data/item/729> ;
    ns1:calligrapher <http://wendang-project.github.io/data/item/1427> ;
    ns1:createsArtwork <http://wendang-project.github.io/data/item/1428> ;
    ns1:description "Hua Jun’s “Double Hook and Simple Heart (Shuanggou suxin 双钩素心)” is a large-scale calligraphic performance artwork created in 2010 . Using his body as an essential medium, the artist inscribed eight massive characters “不生不灭 不增不减” (Non-Born, Non-Destructed, Non-Increased, Non-Decreased) across nearly 2,000 square meters of land at the Tianziling landfill in Hangzhou. This act transformed a site of discarded waste into a space for profound philosophical reflection, embodying Buddhist wisdom about the impermanence and constancy of existence. The execution of this work was recorded into a 7-minute and 12-second video, which was shown at the exhibition \"Shu Fei Shu“ in 2010." ;
    ns1:hasChineseConcept <http://w3id.org/write/thesaurus/buddhism> ;
    ns1:hasPerformingArtType <https://www.wikidata.org/wiki/Q213156> ;
