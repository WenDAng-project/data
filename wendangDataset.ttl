<http://wendang-project.github.io/data/item/312> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q956> ;
    ns2:P1476 "Flying Good Luck (飞来好运)"@en,
        "飞来好运"@zh,
        "Fēi lái hǎo yùn"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/277> ;
