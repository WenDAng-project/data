    ns2:P1476 "A Love Poem Written in Water (写在水中的爱情诗)"@en,
        "写在水中的爱情诗"@zh,
        "Xiě zài shuǐzhōng de àiqíng shī"@zh-Latn ;
    ns2:P175 <http://wendang-project.github.io/data/item/698> ;
