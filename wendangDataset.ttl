    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/530.jpg> ;
    ns1:attributedTitle "CWU Writing the Orchid Pavilion Preface One Time (《兰亭序》)" ;
    ns1:description "This CWU is part of the performance \"Writing the Orchid Pavilion Preface One Time (书写兰亭序一遍)\". It consists of the characters realized by Wu Xixia with a brush dipped in black ink in an airtight inflatable sphere. These characters are part of the “Orchid Pavilion Preface” (Lanting Xu 兰亭序) composed by Wang Xizhi 王羲之 (303–361) in 353. During the writing process, the different forms of the twenty zhi 之 characters present in the poem, were replaced with visible red ink male phalluses. "@en ;
    ns1:directionality "Traditional" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q1396399> ;
