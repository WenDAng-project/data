        <http://wendang-project.github.io/data/item/1015>,
        <http://wendang-project.github.io/data/item/1023>,
        <http://wendang-project.github.io/data/item/1024> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1336646>,
        <https://www.wikidata.org/entity/Q27891820>,
        <https://www.wikidata.org/entity/Q711960> ;
    ns2:P186 <https://www.wikidata.org/entity/Q207849> ;
