<http://wendang-project.github.io/data/item/2630> a ns1:CalliWritingUnit ;
    ns2:P1343 "Vermeeren, Laura. 2020. Inquisitive Ink: A study of contemporary practices of calligraphy in China. Phd dissertation. University of Amsterdam: 209-10. "@en,
        "Today Art Museum (ed.). 2011. Mengbo 2012 梦波2012 (Mengbo 2012). Hong Kong: China Today Art Museum Publishing."@zh ;
    ns2:P180 <https://www.wikidata.org/entity/Q14255687>,
        <https://www.wikidata.org/entity/Q162668>,
        <https://www.wikidata.org/entity/Q220797>,
        <https://www.wikidata.org/entity/Q4916901> ;
