    ns2:P2049 "190 cm" ;
    ns2:P462 <https://www.wikidata.org/entity/Q23444>,
        <https://www.wikidata.org/entity/Q23445>,
        <https://www.wikidata.org/entity/Q42519> ;
    ns2:P571 "2005"^^xsd:gYear ;
    ns2:P608 <http://wendang-project.github.io/data/item/1739> ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1736.jpg> ;
    ns1:description "\"Series of the Image of Dots and Calligraphic Brushstrokes No. 1: Insect-Eroded Wood\" by Zhang Aiguo draws on the style of small seal script, characterized by its uniformity of line. Zhang Aiguo adopts a deconstructive approach to Chinese characters, reinterpreting classical Han Dynasty inscriptions. Drawing on delicate, fluid, and vigorous lines of  the Yuan An Stele, Zhang enhances these formal qualities into a distinctly modern calligraphic language. According to the artist, \"beyond Chinese characters, the most fundamental elements that sustain Chinese calligraphy are dots and strokes. Dots and strokes manifest externally, while brushwork serves as their intrinsic driving force, making brushwork the very soul of calligraphy\" (2005, 30). The interwoven, meandering strokes disrupt the legibility of the original character structures, raising a fundamental question: whether modern calligraphy can exist independently of Chinese characters." ;
    ns1:hasArtworkType <https://www.wikidata.org/entity/Q22669850>,
        <https://www.wikidata.org/entity/Q756712> ;
