    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> ;
    ns1:transcriptionAndTranslation "Flying Good Luck "@en,
        "飞来好运"@zh,
        "Fēi lái hǎo yùn"@zh-Latn .

<http://wendang-project.github.io/data/item/317> a ns1:CalliWritingUnit ;
    ns2:P144 <http://wendang-project.github.io/data/item/318> ;
