    ns2:P1476 "Writing Music - Silent Melodies: \"Se l'aura spira\" (写乐·无声之歌·若微风吹拂)"@en,
        "写乐·无声之歌·当温柔的微风"@zh,
        "Xiě yuè · Wú shēng zhī gē · Dāng wēnróu de wēifēng"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/84> ;
