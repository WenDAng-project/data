    ns2:P856 <https://www.caa.edu.cn/sz/zzfjs/zhangaiguo/zhanlan/index.html> ;
    ns2:P937 <https://www.wikidata.org/entity/Q4970> ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1285.jpg> ;
    ns1:description "Zhang Aiguo 张爱国, also known as Lao Ai (老爱), was born in 1967 in Huai'an, Jiangsu Province, China. He obtained his bachelor's, master's, and doctoral degrees in Calligraphy and Seal Cutting from the China Academy of Art (CAA, 中国美术学院) in Hangzhou, China, where he studied under Professor Wang Dongling 王冬龄. In 2007, he earned his Ph.D. in Literature. Currently, he serves as an Associate Professor and Master's Supervisor in the Department of Calligraphy at the China Academy of Art. He is also a Visiting Professor at Gifu Women's University in Japan (日本岐阜女子大学), a Researcher at the Modern Calligraphy Research Center of the China Academy of Art (中国美术学院现代书法研究中心), and the Deputy Secretary-General of the Lanting Calligraphy Society (兰亭书法社). Zhang is also a member of the China Education Association for Calligraphy, the China Calligraphers Association (中国书法家协会), and holds positions in various calligraphy organizations in Zhejiang Province and Hangzhou City. He is also the inaugural Researcher at the Chinese Calligraphy Research Institute of Southeast University (东南大学中国书法研究院), a Visiting Professor at the School of Arts of Xiamen University (厦门大学艺术学院), and a Visiting Artist at the Chinese University (香港中文大学) of Hong Kong. "@en ;
    ns1:hasCalligraphicTraining "Academic"@en ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/1285.jpg> .

