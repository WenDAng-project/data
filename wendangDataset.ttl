    ns2:P1476 "Landscape Painting Painted in Water (画在水中的山水)"@en,
        "画在水中的山水"@zh,
        "Huà zài shuǐzhōng de shānshuǐ"@zh-Latn ;
    ns2:P175 <http://wendang-project.github.io/data/item/698> ;
