    ns2:P170 <http://wendang-project.github.io/data/item/231> ;
    ns2:P580 "1993"^^xsd:gYear ;
    ns2:P582 "2004"^^xsd:gYear ;
    ns1:description "In 1993 Gu Wenda started a global art project that took him across five continents, selecting twenty-one countries and using over a million strands of hair from local inhabitants to create monumental installations. These works aim to capture the unique identities of each place, while creating a transcultural, hybrid, and syncretic network of \"united and unified nations.\" In this vision, various scripts, such as Chinese, English, Arabic, Hindi, etc., are transformed into pseudo-scripts, no longer essential for human understanding. The utopia of achieving unity within humanity may never be realized in reality, but can become possible through art." ;
    ns1:includesArtwork <http://wendang-project.github.io/data/item/1552> .

<http://wendang-project.github.io/data/item/1557> a ns3:Q17514 ;
    ns2:P1476 "Wood Dragon (灵丹)"@en,
        "灵丹"@zh,
        "Língdān"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/1494>,
