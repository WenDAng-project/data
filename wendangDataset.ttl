<http://wendang-project.github.io/data/item/1511> a ns3:Q17514 ;
    ns2:P1476 "Dongbei (东北)"@en,
        "东北"@zh,
        "東北"@zh,
        "Dōngběi"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/1494>,
        <http://wendang-project.github.io/data/item/1510> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1057925>,
