    ns2:P1476 "Light Writing: The Heart Sutra n. 22 (光写书法：心经 22)"@en,
        "光写书法：心经 22"@zh,
        "Guangxie shufa: Xin Jing n. 22 "@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/249> ;
    ns2:P179 <http://wendang-project.github.io/data/item/555> ;
