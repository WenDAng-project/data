    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/928.jpg> ;
    ns1:derivesFrom <http://wendang-project.github.io/data/item/927> ;
    ns1:description "This artwork was created during the performance \"The Heart Sutra in Chaos Script at the Brooklyn Museum (乱书《心经》现场书写纽约布鲁克林博物馆)\" realized by Wang Dongling on November 7, 2015. Wang Dongling creates the 268 charactes of the Heart Sutra (Xingjing 心经) , a concise and elegant articulation of the core tenets of Mahayana Buddhism using his Chaos Script (luan shu 乱书), making the characters mostly unrecognizable."@en ;
