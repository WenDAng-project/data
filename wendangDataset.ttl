<http://wendang-project.github.io/data/item/1100> a ns3:Q215627 ;
    ns2:P103 <https://www.wikidata.org/entity/Q7850> ;
    ns2:P106 <https://www.wikidata.org/entity/Q121594>,
        <https://www.wikidata.org/entity/Q1792450>,
        <https://www.wikidata.org/entity/Q780596> ;
    ns2:P19 <https://www.wikidata.org/entity/Q21208> ;
    ns2:P21 <https://www.wikidata.org/entity/Q6581097> ;
    ns2:P2561 "Wang Chunchen 王春辰" ;
    ns2:P27 <https://www.wikidata.org/entity/Q148> ;
    ns2:P569 "1964"^^xsd:gYear ;
    ns2:P812 <https://www.wikidata.org/entity/Q50637> ;
    ns2:P937 <https://www.wikidata.org/entity/Q30>,
        <https://www.wikidata.org/entity/Q956> ;
    ns1:description "Wang Chunchen is a professor, doctoral supervisor, art historian, art critic, and curator. He graduated from the Central Academy of Fine Arts and currently works at the Art Museum of the Central Academy of Fine Arts (Zhongyang Meishu Xueyuan Meishu guan 中央美术学院美术馆, CAFAM). He specializes in modern art history and contemporary art theory and criticism. In 2012, he was appointed as a special curator by the Broad Art Museum at Michigan State University, where he curated an exhibition on contemporary Chinese art, making him the first curator from mainland China to be hired by an American art museum. Wang Chunchen has authored several books, including \"Art Intervention in Society\" (Yishu jieru shehui 艺术介入社会; 2010), \"The Democracy of Art\" (Yishu de minzhu 艺术的民主; 2013), and \"The Politics of Images\" (Tuxiang de zhengzhi 图像的政治; 2013). He has received awards such as the China Contemporary Art Award (CCAA) Comment Award in 2009. He has also curated numerous exhibitions, both domestically and internationally, such as the fifth exhibition of the itinerant series \"Boundary of Freedom - Chinese Contemporary Ink\" (Ziyou de chidu - Zhongguo dangdai shuimo zouxiang Ouzhou 自由的尺度-中国当代水墨), that explore themes of contemporary Chinese society, culture, and identity. "@en ;
    ns1:hasCalligraphicTraining "Not present"@en ;
    ns1:hasWikidataResource <https://www.wikidata.org/entity/Q109858771> ;
    ns1:isCuratorOf <http://wendang-project.github.io/data/item/1106> .

