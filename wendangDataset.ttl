    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/480.jpg> ;
    ns1:attributedTitle "CWU Free Cloud Calligraphy (lines)" ;
    ns1:description "This CWU is part of the performance \"Free Cloud Calligraphy (云自在书)\". It is composed by the traces of ink leaved by Zhang Qiang on the paper, while the female counterpart Ding Feifei moves the paper over Zhang Qiang's head, as if to simulate the movement of clouds in the sky. "@en ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23444> ;
