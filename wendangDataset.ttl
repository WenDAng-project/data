    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/545_1.jpg>,
        <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/545_2.jpg>,
