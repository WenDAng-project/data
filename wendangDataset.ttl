<http://wendang-project.github.io/data/item/1001> a ns3:Q464980 ;
    ns2:P10661 <http://wendang-project.github.io/data/item/748> ;
    ns2:P1476 "From the Canglang Pavillion (自·沧浪亭)"@en,
        "自·沧浪亭"@zh,
        "Zì·cāng láng tíng"@zh-Latn ;
    ns2:P1640 <http://wendang-project.github.io/data/item/1002> ;
    ns2:P276 <https://www.wikidata.org/entity/Q42622> ;
    ns2:P580 "2018-05-18"^^xsd:date ;
    ns2:P582 "2018-05"^^xsd:gYearMonth ;
    ns1:description "The exhibition \"From the Canglang Pavilion\" (Zi 自·cang lang ting ·沧浪亭) curated by Wu Hongliang 吴洪亮, opened on May 18, 2018. This exhibition showcases, for the second time in China and for the first time in Suzhou, the installation of 201 bamboo poles together with 30 polypropylene transparent sheets written by Wang Dongling using cursive script, \"chaos script\" and clerical script. These works were originally part of Wang's solo exhibition \"The Bamboo Path,\" held in Shenzhen in 2017."@en ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/910> .

<http://wendang-project.github.io/data/item/1009> a ns1:CalliWritingUnit ;
    ns2:P144 <http://wendang-project.github.io/data/item/1010>,
        <http://wendang-project.github.io/data/item/1012>,
        <http://wendang-project.github.io/data/item/1013>,
