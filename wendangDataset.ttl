    ns2:P1476 "Wang Dongling: The Bamboo Path (王冬龄：竹径)"@en,
        "王冬龄：竹径"@zh,
        "Wáng Dōnglíng: Zhú jìng"@zh-Latn ;
    ns2:P1640 <http://wendang-project.github.io/data/item/762>,
        <http://wendang-project.github.io/data/item/961>,
