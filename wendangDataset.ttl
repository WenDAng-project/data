<http://wendang-project.github.io/data/item/1201> a ns3:Q17514 ;
    ns2:P1476 "R.I.P. 512 Sichuan Earthquake"@en ;
    ns2:P170 <http://wendang-project.github.io/data/item/1191>,
        <http://wendang-project.github.io/data/item/1193> ;
    ns2:P180 <https://www.wikidata.org/entity/Q1142909>,
        <https://www.wikidata.org/entity/Q26237350>,
        <https://www.wikidata.org/entity/Q5003624>,
