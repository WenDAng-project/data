    ns2:P580 "1992-12-17"^^xsd:date ;
    ns2:P582 "1993-02-14"^^xsd:date ;
    ns2:P664 <https://www.wikidata.org/entity/Q114697148>,
        <https://www.wikidata.org/entity/Q1376872> ;
    ns2:P856 <https://museum-fuer-ostasiatische-kunst.de/Start> ;
    ns1:description "The exhibition \"With These Hands\" was a joint exhibition by Chinese calligrapher and artist Huang Miaozi and Gu Gan, and was held at the Museum für Ostasiatische Kunst in Cologne from 17th December 1992 to 14th February 1993. This exhibition was one of the earliest major modern Chinese calligraphy exhibitions held in Western countries. Gu Gan's \"Mit diesen Händen\" (With These Hands) represents the most memorable piece from this exhibition . The work was inspired by Heinrich Böll's 1947 poem of the same name, and was created as a contribution to the international Heinrich-Böll-Symposium held in Cologne in 1992. The exhibition itself took its name from the work. "@en ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/868> .

<http://wendang-project.github.io/data/item/1091> a ns1:CalliWritingUnit ;
