<http://wendang-project.github.io/data/item/1469> a ns3:Q7725634 ;
    ns2:P1476 "The Book of the Way and Its Virtue (道德经) / Laozi (老子)"@en,
        "道德经  / 老子"@zh,
        "Dào dé jīng / Lǎozǐ"@zh-Latn ;
    ns2:P1480 <https://www.wikidata.org/entity/Q5727902> ;
    ns2:P50 <https://www.wikidata.org/entity/Q9333> ;
    ns2:P571 "0350"^^xsd:gYear ;
    ns1:description "The \"Book of the Way and Its Virtue\" (Dao de jing, also spelled Tao Te Ching) is a classic Chinese text traditionally attributed to the sage Laozi, dating back to a period between the 4th and 3rd century BCE. This work represents a foundational text of Daoism, emphasizing the philosophy of living in harmony with the Dao (or Tao), which means \"the Way\" or the fundamental principle underlying the universe. The Dao De Jing consists of 81 short chapters, written in poetic and often paradoxical language. It explores themes such as simplicity, humility, non-action (wu wei), and the balance of opposites (yin and yang). " ;
    ns1:hasWikidataResource <https://www.wikidata.org/entity/Q134425> .

<http://wendang-project.github.io/data/item/1701> a ns3:Q215627 ;
    ns2:P103 <https://www.wikidata.org/entity/Q7850> ;
    ns2:P106 <https://www.wikidata.org/entity/Q121594>,
        <https://www.wikidata.org/entity/Q3303330>,
        <https://www.wikidata.org/entity/Q483501> ;
    ns2:P19 <https://www.wikidata.org/entity/Q71401> ;
    ns2:P21 <https://www.wikidata.org/entity/Q6581097> ;
    ns2:P2561 "Zeng Xiang 曾翔" ;
    ns2:P27 <https://www.wikidata.org/entity/Q7850> ;
    ns2:P569 "1958"^^xsd:gYear ;
    ns2:P742 "Mumutang 木木堂",
        "Qutang 曲堂",
        "Sanyou Zhuliuzhai 三牖竹榴斋",
        "Yifu 一夫" ;
    ns2:P812 <https://www.wikidata.org/entity/Q12681> ;
    ns2:P937 <https://www.wikidata.org/entity/Q956> ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1701.jpg> ;
    ns1:description "Zeng Xiang 曾翔 was born in 1958 in Suizhou, Hubei Province. He holds the title of National First-Class Artist. Currently, Zeng Xiang serves as a researcher at the China National Academy of Painting, where he also mentors the Zeng Xiang Calligraphy Studio. Additionally, he is a graduate advisor at the Changxin International Academy of Art, Yunnan University." ;
    ns1:hasCalligraphicTraining "Academic"@en ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/1701.jpeg> .

<http://wendang-project.github.io/data/item/1876> a ns3:Q464980 ;
    ns2:P10661 <http://wendang-project.github.io/data/item/1096> ;
    ns2:P1476 "Word Play: Contemporary Art by Xu Bing"@en ;
    ns2:P276 <https://www.wikidata.org/entity/Q1192305>,
        <https://www.wikidata.org/entity/Q61> ;
    ns2:P580 "2001-10-21"^^xsd:date ;
    ns2:P582 "2002-01-13"^^xsd:date ;
    ns1:description "The exhibition \"Word Play: Contemporary Art by Xu Bing\" was held from October 21, 2001 to January 13, 2002 at the Arthur M. Sackler Gallery, part of the Smithsonian Institution in Washington D.C., USA. This exhibition showcased several installations by Xu Bing, such as 'Reading Landscape', 'Monkeys grasp for the Moon' and the debut of 'Living Word' (Niao fei le 鸟飞了). The exhibition explored Xu Bing's innovative approach to the Chinese written script, expanding the boundaries of words, images, and ideas." ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/1269>,
        <http://wendang-project.github.io/data/item/1271> .

<http://wendang-project.github.io/data/item/603> a ns3:Q43229 ;
    ns2:P2561 "Library of the University of Bologna"@en ;
    ns2:P276 <https://www.wikidata.org/entity/Q1891> ;
    ns2:P571 "2000"^^xsd:gYear ;
    ns2:P856 <https://bub.unibo.it/it> ;
    ns1:description """The University Library is an autonomous institution of the University of Bologna and has as its mission the protection, conservation, use, promotion, enhancement and development of its bibliographic-documentary and photographic heritage.\r
In particular:\r
- it takes care of the conservation and protection of its heritage and ensures its use by users\r
- provides bibliographic-documentary services\r
- provides for the development of the collections according to the guidelines of the Scientific Committee\r
- participates in national catalogues and specific cataloguing and digitisation projects\r
- is the legal deposit institution for the territory of the metropolitan city of Bologna\r
- promotes the enhancement of its heritage also through temporary exhibitions\r
- promotes and participates in local, national, EU and international research projects related to the knowledge, study and dissemination of its heritage\r
- takes care of, promotes and enhances the documentary and photographic heritage relating to the history of the University (Historical Archive) and organises the selection of the document flow from the deposit archive.\r
In 2017 the Historical Archive of the University of Bologna was added to the Library.\r
In 2018, the International Centre for Humanistic Studies "Umberto Eco" also joined the network."""@en ;
    ns1:hasWikidataResource <https://www.wikidata.org/entity/Q2901539> .

<http://wendang-project.github.io/data/item/605> a ns3:Q43229 ;
    ns2:P2561 "Collegium Musicum Almae Matris"@en ;
    ns2:P276 <https://www.wikidata.org/entity/Q1891> ;
    ns2:P571 "1953"^^xsd:gYear ;
    ns2:P856 <https://collegiumbologna.it/> ;
    ns1:description """The Collegium Musicum Almae Matris, Choir and Orchestra of the University of Bologna, promotes musical activities within the University and concerts for the city of Bologna. Every year it involves more than 300 university students, many of them foreigners, giving them the opportunity to discover or deepen their passion for music by singing in one of their three choirs or playing in the orchestra.\r
We organise numerous concerts and MusicAteneo, the international festival involving university orchestras and choirs from all over the world. It promotes tours and exchange projects with musical groups from foreign universities and offers musical training activities: workshops, laboratories and in-depth meetings.\r
The Collegium collaborates with important cultural institutions in Bologna, such as the Teatro Comunale, the Teatro Duse, the Alliance Française, the Accademia Filarmonica, and the Fondazione Musica Insieme, and with internationally renowned musicians, including: Ezio Bosso, Filippo Maria Bressan, Simon Carrington, Azio Corghi, Paolo Grazia, Piero Monti, Chiara Opalio, Stefan Parkman Zoltán Peskó, Donato Renzetti, Roberto Polastri, Carlo Tenan and Peter Shannon."""@en .

<http://wendang-project.github.io/data/item/683> a ns1:CalliWritingUnit ;
    ns2:P180 <https://www.wikidata.org/entity/Q1023770>,
        <https://www.wikidata.org/entity/Q11425>,
        <https://www.wikidata.org/entity/Q202742>,
        <https://www.wikidata.org/entity/Q62744> ;
    ns2:P186 <https://www.wikidata.org/entity/Q11472>,
        <https://www.wikidata.org/entity/Q207849> ;
    ns2:P462 <https://www.wikidata.org/entity/Q943> ;
    ns1:attributedTitle "CWU Away with the Flow - Taiji Calligraphy & Animation (lines)" ;
    ns1:description "This CWU is part of the artwork \"Away with the Flow - Taiji Calligraphy & Animation (顺气自然 - 太极书法动画)\". It consists of a set of 175 calligraphy drawings visualizing the movement and body language of Taiji practice. Jessie Yingying Gong has drawn lines with a brush dipped in yellow ink, drawing two arms and two legs of a little man that reproduces all the main movements of Taiji."@en ;
    ns1:directionality "Free" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23445> ;
    ns1:hasCalligraphicLine true ;
    ns1:hasSignificance "Set of lines (meaningless)" ;
    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> .

<http://wendang-project.github.io/data/item/842> a ns1:CalliWritingUnit ;
    ns2:P180 <https://www.wikidata.org/entity/Q22669850>,
        <https://www.wikidata.org/entity/Q2434238>,
        <https://www.wikidata.org/entity/Q607543> ;
    ns2:P282 <https://www.wikidata.org/entity/Q8201> ;
    ns2:P462 <https://www.wikidata.org/entity/Q23445> ;
    ns2:P9302 <http://w3id.org/write/thesaurus/cursive_script> ;
    ns1:attributedTitle "CWU Multiple Projected Traditional Calligraphies (unknown)" ;
    ns1:description "This CWU is part of the series of multiple frame traditional calligraphy projected during the dancing performance \"Cursive I\". These traditional calligraphies are projected as a slideshow in the background during the various performances of the dancers: calligraphies in cursive script by Wang Xizhi 王羲之 (303–361), Huai Su 怀素 (737–799), Zhang Xu 张旭 (fl. 8th century) and other famous masters of past dynasties are presented to the audience in large scale, merging with the movements of the dancers in the foreground floor. According to the video of the performance, in total there are about twenty-one frame changes of traditional calligraphic works projected throughout the ballet."@en ;
    ns1:directionality "Traditional" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23444> ;
    ns1:hasCalligraphicLine true ;
    ns1:hasCharacterForm <https://www.wikidata.org/wiki/Q178528> ;
    ns1:hasColophon true ;
    ns1:hasSignificance "Meaningful writing" ;
    ns1:vectorisedOrDigitised true .

