    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1577.jpg> ;
    ns1:attributedTitle "CWU 2 Overturning the Mountains  (《蜀道难》)" ;
    ns1:description "This CWU is composed of two lines from the poem \"The Hard Road to Sichuan\" (Shu dao nan 蜀道难) by the Tang Dynasty poet Li Bai 李白 (701-762). The text surrounds the larger character 'shan' 山 (mountain) in CWU 1, arranged in a free-flowing layout. The two lines include the characters Shan cui 山摧 (\"the mountains collapse\" / \"the mountains are shattered\"). They are reproduced at a larger scale in CWU 1 and serve as the artwork's title. This choice underscores the central theme of both the poem and the calligraphy: the need for regeneration after arduous periods and difficult paths. The colophon reads \"lines by Li Bai\" (Li Bai ju 李白句)." ;
    ns1:directionality "Free" ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23444> ;
