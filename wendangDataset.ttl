    ns2:P282 <https://www.wikidata.org/entity/Q8201> ;
    ns2:P462 <https://www.wikidata.org/entity/Q23444>,
        <https://www.wikidata.org/entity/Q23445>,
        <https://www.wikidata.org/entity/Q42519> ;
    ns2:P9302 <http://w3id.org/write/thesaurus/regular_script> ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/728.jpg> ;
    ns1:attributedTitle "CWU Raindrop Script, Heart Sutra ( 色不異空...)" ;
    ns1:description "This Calli-Writing Unit is composed of four verses of the Heart Sutra: \"Form is not other than emptiness, emptiness is not other than form. Form itself is emptiness, emptiness itself is form\". Using these verses the artist wants to link the artwork with one of the main concept of the Buddhist doctrine that is \"emptiness\" (kong 空). Infact, he uses a tecnique that wants to reproduce the ephimeral nature of the raindrops. For doing this he firstly used a brush full of ink on a plastic sheet, creating droplets on its non-absorbent surface. Then, using a dry brush and the ink droplets left on the plastic sheet, he wrote these four verses of the Heart Sutra. Finally, he positioned a sheet of rice paper on the written plastic sheet, transferring the traced content from the plastic to the paper."@en ;
    ns1:hasBackgroundColour <https://www.wikidata.org/entity/Q23444>,
        <https://www.wikidata.org/entity/Q42519> ;
    ns1:hasCalligraphicLine true ;
    ns1:hasCharacterForm <https://www.wikidata.org/wiki/Q178528> ;
    ns1:hasSignificance "Meaningful writing" ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/728_HR.jpg> ;
    ns1:isUnitOf <http://wendang-project.github.io/data/item/726> ;
    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> ;
    ns1:transcriptionAndTranslation "Form is not other than emptiness, emptiness is not other than form. Form itself is emptiness, emptiness itself is form."@en,
        "色不异空，空不异色，色即是空，空即是色"@zh,
        "色不異空，空不異色，色即是空，空即是色"@zh,
        "Sè bù yì kōng, kōng bù yì sè, sèjíshìkōng, kōngjíshìsè"@zh-Latn .

