    ns2:P1476 "Deer crying (鹿鸣)"@en,
        "鹿鸣"@zh,
        "Lùmíng"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/130> ;
    ns2:P180 <https://www.wikidata.org/entity/Q29838690>,
