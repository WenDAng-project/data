    ns2:P2561 "Ma Lin 马琳" ;
    ns2:P812 <https://www.wikidata.org/entity/Q735> ;
    ns2:P937 <https://www.wikidata.org/entity/Q8686> ;
    ns1:description """Ma Lin is a leading figure in Chinese art management, serving as Deputy Director of the Shanghai Art Museum (China Art Palace) and Shanghai University Art Museum. She is also an associate professor at Shanghai University’s School of Fine Arts, specializing in art management and museum studies.\r
A key member of the China Artists Association and the Chinese Museums Association, she has pioneered public art initiatives, enhancing cultural accessibility. Her contributions in curation, research, and education continue to shape Shanghai’s art scene.""" ;
    ns1:isCuratorOf <http://wendang-project.github.io/data/item/1742> .

<http://wendang-project.github.io/data/item/2048> a ns3:Q215627 ;
