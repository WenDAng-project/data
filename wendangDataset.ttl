    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> .

<http://wendang-project.github.io/data/item/1951> a ns3:Q4502142 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q84> ;
    ns2:P1476 "The Music of Ink at the British Museum: Cursive Writing Poetry (草书歌行) - Artwork"@en,
        "草书歌行"@zh,
        "Cǎoshū gē xíng"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/1949> ;
    ns2:P186 <https://www.wikidata.org/entity/Q11472>,
        <https://www.wikidata.org/entity/Q127418> ;
    ns2:P462 <https://www.wikidata.org/entity/Q23444>,
        <https://www.wikidata.org/entity/Q23445> ;
    ns2:P571 "2005-06-18"^^xsd:date ;
    ns2:P608 <http://wendang-project.github.io/data/item/1955> ;
    ns2:P941 <https://www.wikidata.org/entity/Q3235751>,
        <https://www.wikidata.org/entity/Q3236984>,
        <https://www.wikidata.org/entity/Q7071> ;
    ns1:derivesFrom <http://wendang-project.github.io/data/item/1943> ;
    ns1:description """This artwork was created during the musicalligraphy performance entitled "The Music of Ink at the British Museum - Cursive Writing Poetry (草书歌行)", held during the event "The Music of Ink at the British Museum" on June 18, 2005. While the musician Rohan De Saram played his cello, Zeng Laide transcribed a famous poem from the Tang dynasty written by Li Bai (701 – 762), titled “Cursive writing poetry” (Cao shu ge xing 草书歌行) using the feibai 飞白 (flying white) style.\r
The poem, with its romantic tone and unique imagination, vividly recreates a scene of the calligrapher Huaisu drunkenly and passionately waving his brush, writing in a wild and exuberant manner. It carefully and wonderfully portrays Huaisu's bold and expressive personality traits. The entire poem vividly captures Huaisu’s free-spirited, passionate, and exuberant character. It holds significant reference value for later studies on Huaisu’s cursive script art. In this poem, Li Bai describes calligraphy as music. As Zeng Laide explained:\r
"In Chinese, the title of the poem is Cao shu ge xing. 'Ge xing' means music; ‘cao shu’ refers to a type of calligraphy, specifically the grass script style. Thus, the poem and the calligraphy bring together the classical, the contemporary, and the creative" (Wang 2012, pp. 69-70).""" ;
    ns1:hasArtworkType <https://www.wikidata.org/entity/Q22669850> ;
    ns1:hasUnit <http://wendang-project.github.io/data/item/1953> ;
    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> .

