    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1454_1.jpg>,
        <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/1454_2.jpg>,
