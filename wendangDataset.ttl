    ns1:madeUsingTool <https://www.wikidata.org/entity/Q614467> .

<http://wendang-project.github.io/data/item/2577> a ns3:Q7725310 ;
    ns2:P1476 "Earth Script (土书) "@en,
        "土书"@zh,
        "tǔ shū"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/2358> ;
    ns2:P580 "2015"^^xsd:gYear ;
    ns2:P582 "2018"^^xsd:gYear ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/2577.jpg> ;
    ns1:description """This series was realized in 2018. This series includes works created entirely with soil and water. Ink strokes are replaced by mud, produced through the combination of site-specific soil and water. This mixture spells out characters Origin (ben 本), Colour (se 色), Dust (in two forms: the simplified character chen 尘[塵] and a graphic variant of the non-simplified character chen 薼), Earth (tu 土), and Hope (Wang 望). The content implied by these characters is influenced by Buddhist thought and reflects on the essence of existence. Her engagement with soil starts with the colleciton of soil (cai tu 采土), then prepares mud pigments by mixing soil with water and other media.\r
Song Chen deepened her engagement with soil in another series realized in 2023 and titled Book of Soil - Yangtze River (Turang zhi shu – Changjiang  土壤之书·长江). The project was recorded in a documentary video (Chen 2023). """ ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/2577_HR.jpg> ;
    ns1:includesArtwork <http://wendang-project.github.io/data/item/2578> .

<http://wendang-project.github.io/data/item/2582> a ns3:Q7725310 ;
    ns2:P1071 <https://www.wikidata.org/entity/Q1867> ;
    ns2:P1476 "From Ink to Apparel III - TSAI Yi-Fen Collection"@en,
        "读衣III — 蔡宜芬時裝"@zh,
        "Dú yī III — Cài Yífēn  shízhuāng"@zh-Latn ;
    ns2:P170 <http://wendang-project.github.io/data/item/148> ;
    ns2:P580 "2018"^^xsd:gYear ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/2582.jpg> ;
    ns1:description """This collection by Tsai Yi-fen is part of the exhibition "2018 From Ink to Apparel III" that was held in Taipei. The purpose of this exhibition is to promote Chinese culture in Taiwan through calligraphy art. Curator Tong Yang-Tze invites diverse and talented fashion designers of Chinese ethnicity to participate, create, and accumulate design context inspired by the calligraphy lines. Besides Tsai Yi-fen, other five desigers took part in the exhibition: two from Taiwan (Chou Yu-Ying, Chen Shao-Yen), two from Beijing (Li Ying-Jun, Zhou You) and one from UK (Pan Bernice).The exhibition theme is “wu 無" (emptiness). Tong Yang-tze wrote fourteen fonts of this character which are variations of the cursive script, running script, regular script, clerical script, and seal script. The forms of these characters are distinct, but designers must interpret them visually to form structures, materials, and prints from the fluidity of calligraphy lines and the spaces amongst them.\r
This collection by Tsai Yi-fen is composed of five dresses. It combines lacework and beaded embroideries to create unique textures and tailoring, displaying the space between the real and the void."""@en ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/2582.jpg> ;
    ns1:includesArtwork <http://wendang-project.github.io/data/item/2585> .

<http://wendang-project.github.io/data/item/2593> a ns3:Q464980 ;
    ns2:P10661 <http://wendang-project.github.io/data/item/2597>,
        <http://wendang-project.github.io/data/item/2599> ;
    ns2:P1476 "From Ink to Apparel II"@en,
        "读衣 II"@zh,
        "Dú yī II"@zh-Latn ;
    ns2:P1640 <http://wendang-project.github.io/data/item/814> ;
    ns2:P276 <https://www.wikidata.org/entity/Q1867> ;
    ns2:P580 "2017-11-16"^^xsd:date ;
    ns2:P582 "2017-11-19"^^xsd:date ;
    sch:thumbnailUrl <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/thumbs/2593.jpg> ;
    ns1:description """From Ink To Apparel II (Duyi 讀衣II) was an exhibition project that explored the intersection between contemporary fashion design and Chinese calligraphy. Held in Taipei in 2017, the exhibition represented the second edition of a research initiative focused on translating the visual and gestural language of calligraphy into the field of wearable design.\r
The project investigated how calligraphy, traditionally understood as a two-dimensional practice based on ink and paper, could be reinterpreted through textile materials and the three-dimensional structure of garments. Rather than functioning merely as decorative motifs, calligraphic elements were treated as generative principles capable of informing the construction, silhouette, and spatial dynamics of the clothing.\r
Central to the exhibition was the engagement with the calligraphic practice of Tong Yang-tze, whose work is characterized by expansive, expressive, and highly gestural brushstrokes. Designers participating in the project developed garments that translated these strokes into fabric structures, layered compositions, and printed surfaces. Through processes such as enlargement, fragmentation, and recontextualization, the calligraphic mark was transformed into a visual and structural component within fashion design."""@en ;
    ns1:exhibitedArtwork <http://wendang-project.github.io/data/item/2589> ;
    ns1:image <https://cloud.ditlab.it/public.php/dav/files/b49pfgPgPXNDFtc/2593.jpg> .

<http://wendang-project.github.io/data/item/2605> a ns1:DecorativeAndAppliedArt ;
